{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-web-search",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],

  // TAVILY_API_KEY is set as a wrangler secret (not a plain var — never committed to git):
  //   wrangler secret put TAVILY_API_KEY --name gatekeeper-web-search
  // Get your key at https://app.tavily.com

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebSearchGatekeeper"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
